APP_NAME=AWaReGrid API
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 (Local Docker default; Neon postgresql://... URLs are auto-normalized to asyncpg)
DATABASE_URL=postgresql+asyncpg://awaregrid:awaregrid@localhost:5432/awaregrid

# Redis: Local TCP Redis default; set both UPSTASH_* vars to switch rate limiter to Upstash REST
REDIS_URL=redis://localhost:6379/0
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth / JWT (replace with a strong 32+ byte secret in production)
JWT_SECRET_KEY=dev-only-replace-with-strong-random-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_HOURS=24

# Optional AI Providers (system falls back deterministically when unset)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional extra Gemini keys, comma-separated; Sathi voice rotates on quota (429)
GEMINI_API_KEYS=
